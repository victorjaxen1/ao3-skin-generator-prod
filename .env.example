# AO3 Skin Generator — Environment Variables
# Copy this file to .env.local and fill in the values.

# ImgBB — used by "Copy for AO3" to host the rendered PNG, and by the
# optional file-upload buttons. Get a key at https://api.imgbb.com/
# In production this is set in Netlify: Site settings → Environment variables.
NEXT_PUBLIC_IMGBB_API_KEY=

# Optional: Analytics
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Note: variables prefixed with NEXT_PUBLIC_ are inlined into the browser
# bundle at build time. Only put publishable keys here — never a secret.
