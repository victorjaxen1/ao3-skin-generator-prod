# AO3 SkinGen — Environment Variables
# Copy this file to .env.local and fill in the values.

# Server-only credential used by /api/image-upload.
# Get a key at https://api.imgbb.com/ and set it in Netlify's environment UI.
# Never prefix this key with NEXT_PUBLIC_ or expose it to browser code.
IMGBB_API_KEY=

# Emergency upload kill switch and warm-instance budget controls.
IMAGE_UPLOADS_ENABLED=true
IMAGE_UPLOAD_DAILY_LIMIT=500
IMAGE_UPLOAD_DAILY_BYTES=1073741824
# Optional comma-separated additional origins allowed to upload.
IMAGE_UPLOAD_ALLOWED_ORIGINS=

# Optional analytics identifier. This value is intentionally public.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Variables prefixed with NEXT_PUBLIC_ are inlined into browser bundles.
# Only put intentionally public values in them.
